# ═══════════════════════════════════════════════════════════════
#  Swing Trade Bot — Arquivo de Configuração de Ambiente
# ═══════════════════════════════════════════════════════════════
#
#  INSTRUÇÕES:
#  1. Copie este arquivo: cp .env.example .env
#  2. Preencha com suas credenciais reais
#  3. NUNCA commite o arquivo .env — ele está no .gitignore
#
# ───────────────────────────────────────────────────────────────
# EXCHANGE — OKX
# ───────────────────────────────────────────────────────────────
EXCHANGE_ID=okx

# Credenciais geradas no painel da OKX em: API Management
API_KEY=SUA_API_KEY_AQUI
API_SECRET=SEU_API_SECRET_AQUI

# Passphrase definida por você ao criar a chave de API (obrigatório na OKX)
API_PASSPHRASE=SUA_PASSPHRASE_AQUI

# ───────────────────────────────────────────────────────────────
# MODO DE OPERAÇÃO
# ───────────────────────────────────────────────────────────────
# True  = Paper Trading / Demo (OKX Demo Trading) — recomendado para validar
# False = Dinheiro real — use somente após validar em demo!
TESTNET=True

# ───────────────────────────────────────────────────────────────
# PARES OPERADOS (separados por vírgula)
# ───────────────────────────────────────────────────────────────
# Pares correlacionados sugeridos (coins de pagamento / baixo cap):
SYMBOLS=LTC/USDT,ADA/USDT,XRP/USDT,SOL/USDT

# ───────────────────────────────────────────────────────────────
# TIMEFRAMES DA ESTRATÉGIA
# ───────────────────────────────────────────────────────────────
TIMEFRAME_TREND=4h   # Tendência principal (recomendado: 4h)
TIMEFRAME_ENTRY=1h   # Gatilho de entrada (recomendado: 1h)

# ───────────────────────────────────────────────────────────────
# GERENCIAMENTO DE RISCO
# ───────────────────────────────────────────────────────────────
# Percentual máximo do saldo em USDT arriscado por operação (por par)
# Exemplo com $2000: RISK_PCT=1.5 → arrisca $30 por operação
RISK_PCT=1.5

# Relação Risco/Retorno para o Take Profit (1:RR_RATIO)
RR_RATIO=2.0

# Número de candles usados para encontrar a mínima do Stop Loss
SL_CANDLES=2

# Buffer aplicado abaixo da mínima para posicionar o SL (em %)
SL_BUFFER_PCT=0.5

# Tamanho máximo de cada posição como % do saldo total
# Evita que uma posição consuma mais saldo do que o disponível
# Exemplo: 25.0 → cada trade usa no máximo 25% do saldo ($500 em $2000)
# Com 4 pares ativos simultaneamente: 4 × 25% = 100% do saldo alocado no pior caso
MAX_POSITION_PCT=25.0

# ───────────────────────────────────────────────────────────────
# TRAILING STOP
# ───────────────────────────────────────────────────────────────
# Lucro mínimo (%) para ativar o trailing stop
# 4H/1H: recomendado 2.0 | 15M/5M: recomendado 1.0
TRAILING_ACTIVATION_PCT=2.0

# Distância (%) que o trailing SL fica abaixo da máxima histórica
# 4H/1H: recomendado 3.5 | 15M/5M: recomendado 2.0
TRAILING_STOP_PCT=3.5

# ───────────────────────────────────────────────────────────────
# PARÂMETROS DO RSI
# ───────────────────────────────────────────────────────────────
# ───────────────────────────────────────────────────────────────
# ESTRATÉGIA: TRIPLE EMA CROSS + RSI FILTER
# ───────────────────────────────────────────────────────────────
EMA_FAST=9           # EMA rápida — gera o cruzamento de entrada
EMA_MID=21           # EMA média  — referência do cruzamento e tendência
EMA_SLOW=55          # EMA lenta  — filtro de tendência principal

# Zona saudável do RSI para entrada (não sobrecomprado, com momentum)
RSI_MIN=40
RSI_MAX=65

# Quantos candles atrás verificar se o cruzamento aconteceu
SIGNAL_LOOKBACK=3

# ───────────────────────────────────────────────────────────────
# TELEGRAM — NOTIFICAÇÕES
# ───────────────────────────────────────────────────────────────
# Como configurar:
#   1. Abra o Telegram e procure por @BotFather
#   2. Envie /newbot e siga as instruções para criar o bot
#   3. Copie o token gerado para TELEGRAM_BOT_TOKEN
#   4. Procure por @userinfobot e envie qualquer mensagem
#   5. Copie o seu chat_id para TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI

# ───────────────────────────────────────────────────────────────
# OPERACIONAL
# ───────────────────────────────────────────────────────────────
CHECK_INTERVAL=900   # Intervalo entre checagens em segundos (900 = 15 minutos)
OHLCV_LIMIT=200      # Quantidade de candles históricos baixados por requisição

# Arquivo de log do bot
LOG_FILE=bot_trade.log

# Arquivo CSV com histórico de todas as operações fechadas
HISTORY_FILE=trade_history.csv
