# ═══════════════════════════════════════════════════════════════
#  DCA Trading Bot — Arquivo de Configuração de Ambiente
# ═══════════════════════════════════════════════════════════════
#
#  INSTRUÇÕES:
#  1. Copie este arquivo: cp .env.example .env
#  2. Preencha com suas credenciais reais
#  3. NUNCA commite o arquivo .env — ele está no .gitignore
#
# ───────────────────────────────────────────────────────────────
# EXCHANGE — OKX
# ───────────────────────────────────────────────────────────────
EXCHANGE_ID=okx

# Credenciais geradas em: OKX → API Management
API_KEY=SUA_API_KEY_AQUI
API_SECRET=SEU_API_SECRET_AQUI
API_PASSPHRASE=SUA_PASSPHRASE_AQUI

# False = conta real | True = OKX Demo Trading (paper trading)
TESTNET=False

# ───────────────────────────────────────────────────────────────
# PARES MONITORADOS
# ───────────────────────────────────────────────────────────────
# Lista separada por vírgulas. A moeda de quote define o saldo usado.
PAIRS=BTC/USDT,ETH/USDT,SOL/USDT

# ───────────────────────────────────────────────────────────────
# PARÂMETROS DA ESTRATÉGIA DCA
# ───────────────────────────────────────────────────────────────
# Queda mínima em % em relação à última compra para acionar novo aporte
DCA_DROP_PCT=3.0

# Valor em quote currency (ex: USDT) por aporte
ORDER_SIZE_USDT=20.0

# % acima do preço médio para vender toda a posição (Take Profit)
TAKE_PROFIT_PCT=1.5

# Número máximo de aportes DCA por par (segurança contra quedas prolongadas)
MAX_DCA_ORDERS=10

# ───────────────────────────────────────────────────────────────
# TRAILING STOP (padrão inicial — ajustável via Telegram sem reiniciar)
# ───────────────────────────────────────────────────────────────
# Ativa trailing stop por padrão (pode ser alterado pelo menu do Telegram)
TRAILING_STOP_ENABLED=False

# % abaixo do pico para acionar a venda (ex: 1.0 = vende se cair 1% do máximo)
TRAILING_STOP_PCT=1.0

# ───────────────────────────────────────────────────────────────
# OPERACIONAL
# ───────────────────────────────────────────────────────────────
# Taxa do taker na OKX Spot (0.001 = 0.1%). Usada para PnL preciso quando
# a exchange não retorna o campo fee na resposta da ordem.
FEE_RATE=0.001

# Intervalo entre ciclos de checagem (segundos)
CHECK_INTERVAL=60

# Arquivo de estado das posições (JSON)
STATE_FILE=state.json

# Arquivo de log
LOG_FILE=dca_bot.log

# ───────────────────────────────────────────────────────────────
# TELEGRAM — NOTIFICAÇÕES E COMANDOS
# ───────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=SEU_TOKEN_AQUI
TELEGRAM_CHAT_ID=SEU_CHAT_ID_AQUI

# Horário do relatório diário (HH:MM UTC)
DAILY_REPORT_TIME=00:00
