# ═══════════════════════════════════════════════════════════════
#  BCH/USDC Swing Trade Bot — Arquivo de Configuração de Ambiente
# ═══════════════════════════════════════════════════════════════
#
#  INSTRUÇÕES:
#  1. Copie este arquivo: cp .env.example .env
#  2. Preencha com suas credenciais reais
#  3. NUNCA commite o arquivo .env — ele está no .gitignore
#
# ───────────────────────────────────────────────────────────────
# EXCHANGE — OKX El Salvador
# ───────────────────────────────────────────────────────────────
EXCHANGE_ID=okx

# Credenciais geradas no painel da OKX em: API Management
API_KEY=SUA_API_KEY_AQUI
API_SECRET=SEU_API_SECRET_AQUI

# Passphrase definida por você ao criar a chave de API (obrigatório na OKX)
API_PASSPHRASE=SUA_PASSPHRASE_AQUI

# ───────────────────────────────────────────────────────────────
# MODO DE OPERAÇÃO
# ───────────────────────────────────────────────────────────────
# True  = Paper Trading / Demo (OKX Demo Trading) — recomendado para validar
# False = Dinheiro real — use somente após validar em demo!
TESTNET=True

# ───────────────────────────────────────────────────────────────
# PAR E TIMEFRAMES DA ESTRATÉGIA
# ───────────────────────────────────────────────────────────────
SYMBOL=BCH/USDC
TIMEFRAME_TREND=1d   # Gráfico diário — filtro de tendência (EMA 50)
TIMEFRAME_ENTRY=4h   # Gráfico 4 horas — gatilho de entrada (EMA20, EMA50, RSI14)

# ───────────────────────────────────────────────────────────────
# GERENCIAMENTO DE RISCO
# ───────────────────────────────────────────────────────────────
# Percentual máximo do saldo em USDC arriscado por operação
RISK_PCT=1.5

# Relação Risco/Retorno para o Take Profit (1:RR_RATIO)
# Exemplo: 2.0 → se risco é $20, alvo de lucro é $40
RR_RATIO=2.0

# Número de candles de 4H usados para encontrar a mínima do Stop Loss
SL_CANDLES=5

# Buffer aplicado abaixo da mínima para posicionar o SL (em %)
# Exemplo: 1.0 → SL fica 1% abaixo da mínima dos últimos 5 candles
SL_BUFFER_PCT=1.0

# ───────────────────────────────────────────────────────────────
# PARÂMETROS DO RSI
# ───────────────────────────────────────────────────────────────
RSI_OVERSOLD=30      # Nível de sobrevenda (zona de reversão)
RSI_LOOKBACK=3       # Candles anteriores para verificar se RSI esteve em sobrevenda

# ───────────────────────────────────────────────────────────────
# OPERACIONAL
# ───────────────────────────────────────────────────────────────
CHECK_INTERVAL=900   # Intervalo entre checagens em segundos (900 = 15 minutos)
OHLCV_LIMIT=200      # Quantidade de candles históricos baixados por requisição

# Arquivo JSON para persistir o estado da posição entre reinicializações
STATE_FILE=position_state.json

# Arquivo de log do bot
LOG_FILE=bot_trade.log
